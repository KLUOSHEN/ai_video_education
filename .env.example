# 复制为 .env 后按需填写；未填写时使用本地开发生成器。
PORT=3000
API_KEY=
# 生产环境请替换为至少 32 字节的随机字符串。
DATA_ENCRYPTION_KEY=change-this-to-a-long-random-production-secret
# 通用第三方适配器：服务接收 JSON { text, voice } / { text }，返回 { url } 或 { data: { url } }。
TTS_PROVIDER_URL=
TTS_API_KEY=
VIDEO_PROVIDER_URL=
VIDEO_API_KEY=
# 豆包 Seedance 视频生成（火山方舟 ARK）
ARK_API_KEY=
ARK_VIDEO_MODEL=doubao-seedance-1-0-pro-250528
# 豆包语音合成 TTS（回退用；新版控制台用 API Key）
DOUBAO_TTS_API_KEY=
# Qwen 语音合成 TTS（CosyVoice，共用 QWEN_API_KEY）
# TTS_PROVIDER=qwen 表示强制用 Qwen；留空则自动选择（优先 Qwen，回退豆包）。
TTS_PROVIDER=
QWEN_TTS_VOICE=longanyang
QWEN_TTS_MODEL=cosyvoice-v3-flash
# 优先使用 Qwen 生成讲解稿；未配置时回退到豆包 ARK
QWEN_API_KEY=
QWEN_CHAT_MODEL=qwen-max
# 豆包 LLM（备用）
ARK_CHAT_MODEL=doubao-1-5-pro-32k-250115
