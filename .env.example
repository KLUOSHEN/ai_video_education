# ── 服务与访问控制 ──
PORT=3000
# 仅在服务直接位于可信反向代理后方时设为 true，启用 X-Forwarded-For 客户端 IP。
TRUST_PROXY=false
RATE_LIMIT_MAX=60
REQUEST_TIMEOUT_MS=120000
HEADERS_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=5000
# 生产环境填写唯一的 HTTPS 前端来源，不要使用 *。
CORS_ORIGIN=http://localhost:3000
# 设置后所有 API（健康探针除外）都要求 Authorization: Bearer 或 X-API-Key。
API_KEY=
# 生产环境替换为至少 32 字节的随机字符串。
DATA_ENCRYPTION_KEY=change-this-to-a-long-random-production-secret

# ── 持久化路径 ──
# 云平台请改为持久卷的绝对路径；留空时使用仓库内 data/ 与 storage/。
APP_DATA_DIR=
APP_STORAGE_DIR=
RAG_INDEX_FILE=

# ── 可选 Django 服务 ──
AI_CLASSROOM_BASE=http://localhost:8000

# ── 通用第三方适配器 ──
# TTS 接收 JSON { text, voice }，视频服务接收 JSON { text }；均返回 { url } 或 { data: { url } }。
TTS_PROVIDER_URL=
TTS_API_KEY=
VIDEO_PROVIDER_URL=
VIDEO_API_KEY=

# ── Qwen：文本、图片与语音 ──
QWEN_API_KEY=
QWEN_IMAGE_API_KEY=
QWEN_CHAT_MODEL=qwen-max
QWEN_OUTLINE_MODEL=
QWEN_TTS_VOICE=longanyang
QWEN_TTS_MODEL=cosyvoice-v3-flash

# 可为课件各阶段单独覆盖模型；留空时回退 Qwen 默认模型。
STAGE_OUTLINE_MODEL=
STAGE_PAGE_MODEL=
STAGE_NARRATION_MODEL=
PPT_EDIT_MODEL=

# ── 火山方舟：备用文本与 Seedance 视频生成 ──
ARK_API_KEY=
ARK_CHAT_MODEL=doubao-1-5-pro-32k-250115
ARK_VIDEO_MODEL=doubao-seedance-1-0-pro-250528

# ── DeepSeek：技能解释 ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 本地 Edge TTS 回退 ──
PYTHON=python
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=+8%
