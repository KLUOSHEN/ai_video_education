{
  "name": "ai-learning-studio-backend",
  "version": "1.0.0",
  "private": true,
  "description": "栈知映：以AI光影，筑程序学习之路 — 搜索、音视频生成与题目评测服务",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "build": "next build",
    "check:deploy": "node scripts/check-deploy.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "diagnose:skilltree": "node scripts/diagnostics/check-skilltree-depth.js",
    "diagnose:tasks": "node scripts/diagnostics/inspect-tasks.js",
    "diagnose:slides": "node scripts/diagnostics/inspect-slides.js",
    "web:inline": "node scripts/diagnostics/inline-next-export.mjs",
    "web:dev": "next dev -p 3001",
    "web:build": "next build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "motion": "^13.1.1",
    "next": "^16.3.3",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
